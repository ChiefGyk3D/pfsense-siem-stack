# pfSense Suricata → OpenSearch → Grafana Configuration
# =====================================================
# Copy to config.env and edit:  cp config.env.example config.env
# DO NOT commit config.env to git (it's in .gitignore)

# ── SIEM Server (runs OpenSearch, Logstash, Grafana) ──────────────────────────
SIEM_HOST=192.168.1.10
OPENSEARCH_PORT=9200
LOGSTASH_UDP_PORT=5140
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=admin

# SSH user for the SIEM server (used to deploy Logstash config)
# setup.sh defaults to your current username if not set
#SIEM_SSH_USER=chiefgyk3d

# ── pfSense Firewall ──────────────────────────────────────────────────────────
PFSENSE_HOST=192.168.1.1
# SSH user for pfSense (default 'admin' on pfSense CE 2.7+, was 'root' on older)
PFSENSE_USER=admin

# ── Forwarder (runs on pfSense) ──────────────────────────────────────────────
# Debug mode: creates verbose log file on pfSense (only for troubleshooting)
DEBUG_ENABLED=false
DEBUG_LOG=/var/log/suricata_forwarder_debug.log

# ── OpenSearch Index Settings ─────────────────────────────────────────────────
INDEX_PREFIX=suricata
# pfBlockerNG index pattern (managed by Telegraf opensearch output)
# Uses pattern: pfblockerng-YYYY.MM.dd — no configuration needed here
# Days to keep data (0 = forever). Use scripts/configure-retention-policy.sh
RETENTION_DAYS=30

# ── InfluxDB (for pfSense system metrics via Telegraf) ────────────────────────
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=pfsense
# INFLUXDB_USER=pfsense
# INFLUXDB_PASS=changeme

# ── GeoIP (auto-detected, usually no changes needed) ─────────────────────────
# The forwarder auto-searches for GeoIP databases in common pfSense paths.
# If you have ntopng installed: /usr/local/share/ntopng/GeoLite2-City.mmdb
# Set this only if your DB is in a non-standard location:
#GEOIP_DB_PATH=/usr/local/share/ntopng/GeoLite2-City.mmdb
