# pfSense Suricata → OpenSearch → Grafana Configuration
# =====================================================
# Copy to config.env and edit:  cp config.env.example config.env
# DO NOT commit config.env to git (it's in .gitignore)

# ── SIEM Server (runs OpenSearch, Logstash, Grafana) ──────────────────────────
SIEM_HOST=192.168.1.10
OPENSEARCH_PORT=9200
LOGSTASH_UDP_PORT=5140
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# REQUIRED: the real Grafana admin password. setup.sh and install.sh refuse 'admin' and empty values.
# install.sh generates one if you leave its prompt empty; put that value here for setup.sh.
GRAFANA_ADMIN_PASS=

# ── Network exposure (safe by default) ────────────────────────────────────────
# Out of the box OpenSearch listens on 127.0.0.1 only and ufw opens nothing to "anyone".
# install.sh reads these (as KEY=VALUE, never executed). With sudo, put them here or use `sudo -E`.
#
# IPs/CIDRs (comma separated) that may send events to Logstash UDP 5140. Defaults to the pfSense
# address you type into install.sh. Required.
#LOGSTASH_ALLOWED_SOURCES=192.168.1.1
# IPs/CIDRs (comma separated) that may open the Grafana web UI (3000). Required.
#GRAFANA_ALLOWED_SOURCES=192.168.1.0/24
# OpenSearch bind address. Leave at the default unless something on ANOTHER host must reach 9200.
# For setup.sh from a workstation, prefer an SSH tunnel:
#   ssh -N -L 9200:127.0.0.1:9200 user@siem-host    then    OPENSEARCH_URL=http://127.0.0.1:9200 ./setup.sh
#OPENSEARCH_BIND=127.0.0.1
# Required if OPENSEARCH_BIND is not loopback: who may reach 9200.
#OPENSEARCH_ALLOWED_SOURCES=192.168.1.20
# Required (=true) if OPENSEARCH_BIND is not loopback. The installer does not provision the
# OpenSearch security plugin, so the API on that address has NO authentication; this is your ack.
#OPENSEARCH_DISABLE_SECURITY=false
#
# !!! DANGER !!! Restores the OLD behavior: OpenSearch on 0.0.0.0 with the security plugin disabled,
# ufw 9200, 5140, 8086 and 3000 open to EVERY source, and the Grafana 'admin' password accepted.
# Anyone who can route to the SIEM can read, change and delete every index. Leave this false.
INSECURE_OPEN_ACCESS=false

# SSH user for the SIEM server (used to deploy Logstash config)
# setup.sh defaults to your current username if not set
#SIEM_SSH_USER=youruser

# ── pfSense Firewall ──────────────────────────────────────────────────────────
PFSENSE_HOST=192.168.1.1
# SSH user for pfSense (default 'admin' on pfSense CE 2.7+, was 'root' on older)
PFSENSE_USER=admin

# ── Forwarder (runs on pfSense) ──────────────────────────────────────────────
# Debug mode: creates verbose log file on pfSense (only for troubleshooting)
DEBUG_ENABLED=false
DEBUG_LOG=/var/log/suricata_forwarder_debug.log

# ── OpenSearch Index Settings ─────────────────────────────────────────────────
INDEX_PREFIX=suricata
# pfBlockerNG index pattern (managed by Telegraf opensearch output)
# Uses pattern: pfblockerng-YYYY.MM.dd — no configuration needed here
# Days to keep data (0 = forever). Use scripts/configure-retention-policy.sh
RETENTION_DAYS=30

# ── InfluxDB (for pfSense system metrics via Telegraf) ────────────────────────
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=pfsense
# INFLUXDB_USER=pfsense
# INFLUXDB_PASS=changeme

# ── GeoIP (auto-detected, usually no changes needed) ─────────────────────────
# The forwarder auto-searches for GeoIP databases in common pfSense paths.
# If you have ntopng installed: /usr/local/share/ntopng/GeoLite2-City.mmdb
# Set this only if your DB is in a non-standard location:
#GEOIP_DB_PATH=/usr/local/share/ntopng/GeoLite2-City.mmdb
